{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synaploom.dev/v1/ai.schema.json",
  "title": "AIContracts",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["question", "contextItems"],
      "properties": {
        "question": {
          "type": "string"
        },
        "contextItems": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
