{
  "name": "synaploom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "check:type-strip": "node --disable-warning=ExperimentalWarning scripts/check-type-strip.mjs",
    "test": "node scripts/test/run-vitest-batches.mjs && node --test scripts/dev/full.test.mjs",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "validate:example": "pnpm course:validate examples/frontend-performance-foundations",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm check:type-strip && pnpm build",
    "verify": "pnpm verify:fast && pnpm test:e2e --project=go-runtime",
    "go:fmt": "test -z \"$(gofmt -l cmd internal generated/go 2>/dev/null)\"",
    "go:test": "bash scripts/go/with-internal-toolchain.sh test ./...",
    "go:vet": "bash scripts/go/with-internal-toolchain.sh vet ./...",
    "go:staticcheck": "bash scripts/go/with-internal-toolchain.sh tool staticcheck ./...",
    "go:verify": "pnpm go:fmt && pnpm go:test && pnpm go:vet && pnpm go:staticcheck",
    "contracts:generate": "node scripts/contracts/generate-typescript.mjs && bash scripts/contracts/generate-go.sh",
    "contracts:check": "node scripts/contracts/check-generated.mjs && bash scripts/contracts/check-go-generated.sh",
    "conformance:contracts": "vitest run tests/conformance/contracts/conformance.test.ts",
    "conformance:runner": "vitest run tests/conformance/process/runner-parity.test.ts",
    "go:build-preview": "node scripts/go/build-preview.mjs",
    "dev:full": "node scripts/dev/full.mjs",
    "build:web": "pnpm --filter @synaploom/web build",
    "go:stage-web": "pnpm build:web && node scripts/go/stage-web-assets.mjs && node scripts/go/verify-web-inventory.mjs",
    "go:verify-web-inventory": "node scripts/go/verify-web-inventory.mjs",
    "go:release": "node scripts/go/release.mjs",
    "go:verify-release": "node scripts/go/verify-native-release.mjs",
    "go:build": "node scripts/go/build-native.mjs",
    "go:archive-source": "node scripts/go/archive-source.mjs",
    "go:write-release-evidence": "node scripts/go/write-release-evidence.mjs",
    "course:validate": "bash scripts/go/with-internal-toolchain.sh run ./cmd/synaploom course validate",
    "validate:multi-domain": "pnpm course:validate examples/multi-domain-foundations",
    "test:activity-engine": "pnpm exec vitest run --project dom apps/web/src/features/activity-engine apps/web/src/features/lesson-content apps/web/src/features/chapter-assessment --maxWorkers=2 && bash scripts/go/with-internal-toolchain.sh test ./internal/activity ./internal/course ./internal/server ./internal/progression ./internal/storage",
    "test:activity-engine-docs": "node --experimental-strip-types --test tests/activity-engine-docs.spec.ts",
    "test:workspace-presentation-docs": "node --experimental-strip-types --test tests/workspace-presentation-docs.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@sparticuz/chromium": "149.0.0",
    "@synaploom/contracts": "workspace:*",
    "@synaploom/course-loader": "workspace:*",
    "@synaploom/course-validator": "workspace:*",
    "@synaploom/eslint-config": "workspace:*",
    "@synaploom/security": "workspace:*",
    "@synaploom/test-config": "workspace:*",
    "@synaploom/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.21",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.1",
    "vitest": "4.1.10",
    "json-schema-to-typescript": "15.0.3"
  },
  "imports": {
    "#test/*": "./tests/*.ts",
    "#conformance/*": "./tests/conformance/*.ts"
  }
}
